# Local dev only. Copy to .dev.vars (gitignored) and fill in real values.
# For prod, set TURNSTILE_SECRET_KEY via `wrangler secret put TURNSTILE_SECRET_KEY`.
# The PUBLIC_TURNSTILE_SITE_KEY duplicates wrangler.jsonc#vars so local `astro dev`
# (which doesn't read wrangler.jsonc#vars) still has it.

PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
