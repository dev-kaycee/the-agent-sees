---
interface Props {
  middle?: string;
  right?: string;
}
const { middle = "STUDIO · Nº01", right = "2026 →" } = Astro.props;
---
<div class="meta">
  <span class="meta__primary">THE AGENT SEES</span>
  <span class="meta__center">{middle}</span>
  <span class="meta__right">{right}</span>
</div>

<style>
  .meta {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    padding-inline: var(--spacing-gutter-sm);
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--color-hairline);
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-mute);
  }
  @media (min-width: 48rem) {
    .meta { padding-inline: var(--spacing-gutter-md); }
  }
  @media (min-width: 64rem) {
    .meta { padding-inline: var(--spacing-gutter-lg); }
  }
  .meta__primary { color: var(--color-paper); }
  .meta__center { text-align: center; }
  .meta__right { text-align: right; }
</style>
