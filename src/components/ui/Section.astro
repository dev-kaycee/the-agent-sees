---
interface Props {
  label?: string;
  id?: string;
  /** "default" (ink) | "alt" (ink-2) */
  tone?: "default" | "alt";
  /** "compact" trims vertical padding */
  density?: "default" | "compact";
}
const { label, id, tone = "default", density = "default" } = Astro.props;
const bg = tone === "alt" ? "var(--color-ink-2)" : "var(--color-ink)";
const pad =
  density === "compact"
    ? "py-[1.5rem] md:py-[2.5rem] lg:py-[3.5rem]"
    : "py-[2rem] md:py-[3.5rem] lg:py-[5rem]";
---
<section
  id={id}
  class={`px-[var(--spacing-gutter-sm)] md:px-[var(--spacing-gutter-md)] lg:px-[var(--spacing-gutter-lg)] ${pad}`}
  style={`background: ${bg};`}
>
  {label && <p class="label mb-6">{label}</p>}
  <slot />
</section>
