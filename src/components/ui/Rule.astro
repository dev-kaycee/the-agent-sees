---
interface Props {
  /** "ink" (visible) | "hairline" (subtle) */
  weight?: "ink" | "hairline";
}
const { weight = "ink" } = Astro.props;
const color =
  weight === "ink" ? "var(--color-hairline-strong)" : "var(--color-hairline)";
---
<hr style={`border: 0; border-top: 1px solid ${color}; margin: 0;`} />
