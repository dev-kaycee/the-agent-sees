---
interface Props {
  size?: number;
  class?: string;
}
const { size = 16, class: className = "" } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <line x1="8" y1="3" x2="8" y2="13" />
  <line x1="3" y1="8" x2="13" y2="8" />
</svg>
