---
export const prerender = true;

import Base from "../components/layout/Base.astro";
import Section from "../components/ui/Section.astro";
import Rule from "../components/ui/Rule.astro";
import OpsTeam from "../components/islands/OpsTeam.tsx";

const builds = [
  {
    label: "Live",
    title: "Your ops team in a box",
    sub: "Four agents — Customer Success, Operations, Founder, Comms — handle any business event in 15 seconds. Pick a sector, pick an example, watch them work.",
    meta: "Agents · Workers AI · SSE",
  },
  {
    label: "In build",
    title: "The Agent Sees — site",
    sub: "An honest studio site. Astro on Cloudflare Workers, zero-JS prerendered pages, self-hosted fonts. You're reading the build.",
    meta: "Astro · Cloudflare · Tailwind 4",
  },
];

const nextUp = [
  "Contact form on D1 + Resend (Plan 3)",
  "More sectors, more example scenarios",
  "Wiring this into a real Slack workspace as a Bolt app",
];

// Public site key for Cloudflare Turnstile.
const turnstileSiteKey = "0x4AAAAAADRM5l2r0QMiXnmH";
---
<Base title="Work — The Agent Sees" metaMiddle="WORK · DEMOS" metaRight="2026 →">
  <!-- HEADER -->
  <section class="work-hero">
    <div class="work-hero__inner">
      <p class="label">Work / Demos</p>
      <h1 class="work-hero__head">Four agents.<br />The work of a small team.<br />In fifteen seconds.</h1>
      <p class="work-hero__sub">
        Drop in a real event from your business — a new customer, an angry refund, a 1-star review, a referral. Four AI agents act as four roles on your team: Customer Success drafts the reply, Operations writes the task list, the Founder note surfaces the strategy, and Comms posts the team announcement. One input. Four artifacts. Fifteen seconds.
      </p>
    </div>
  </section>

  <Rule weight="ink" />

  <!-- DEMO -->
  <Section label="Live demo · Your ops team in a box" id="demo">
    <div class="demo-shell">
      <div class="demo-shell__copy">
        <h2 class="demo-shell__head">One event in.<br />A whole team out.</h2>
        <p class="demo-shell__body">
          <strong>Customer Success</strong> writes the message you'd send the customer.
        </p>
        <p class="demo-shell__body">
          <strong>Operations</strong> turns it into a task list — who does what, by when, why.
        </p>
        <p class="demo-shell__body">
          <strong>Founder</strong> surfaces the strategic angle and the one thing only you can do.
        </p>
        <p class="demo-shell__body">
          <strong>Comms</strong> posts to the team and drafts the external angle if there is one.
        </p>
        <p class="demo-shell__body demo-shell__body--mute">
          Six sectors of starter examples — SaaS, e-commerce, agency, local, coach, clinic. Or type your own. Free model. No signup.
        </p>
      </div>
      <div class="demo-shell__island">
        <OpsTeam client:visible turnstileSiteKey={turnstileSiteKey} />
      </div>
    </div>
  </Section>

  <Rule weight="ink" />

  <!-- RECENT BUILDS -->
  <Section label="Recent &amp; in build">
    <div class="builds">
      {builds.map((b) => (
        <article class="build">
          <p class="build__meta">
            <span class="build__label">{b.label}</span>
            <span class="build__tech">{b.meta}</span>
          </p>
          <h3 class="build__title">{b.title}</h3>
          <p class="build__sub">{b.sub}</p>
        </article>
      ))}
    </div>
  </Section>

  <Rule weight="ink" />

  <!-- WHAT'S NEXT -->
  <Section label="What's next" tone="alt">
    <div class="next">
      <h2 class="next__head">On deck.</h2>
      <ol class="next__list">
        {nextUp.map((item, i) => (
          <li>
            <span class="next__num">{String(i + 1).padStart(2, "0")}</span>
            <span>{item}</span>
          </li>
        ))}
      </ol>
      <p class="next__foot">
        Want this team wired into your inbox or CRM? <a href="/contact" class="next__link">Tell us what you're building.</a>
      </p>
    </div>
  </Section>
</Base>

<style>
  .work-hero {
    padding-inline: var(--spacing-gutter-sm);
    padding-block: 2.5rem;
  }
  @media (min-width: 48rem) { .work-hero { padding-inline: var(--spacing-gutter-md); padding-block: 3.5rem; } }
  @media (min-width: 64rem) { .work-hero { padding-inline: var(--spacing-gutter-lg); padding-block: 5rem; } }
  .work-hero__inner { max-width: 78rem; margin-inline: auto; }
  .work-hero__head {
    font-size: var(--text-3xl);
    line-height: 1.0;
    margin: 1rem 0 1.5rem;
    max-width: 22ch;
  }
  @media (min-width: 48rem) { .work-hero__head { font-size: var(--text-4xl); } }
  @media (min-width: 64rem) { .work-hero__head { font-size: var(--text-5xl); } }
  .work-hero__sub {
    font-size: var(--text-base);
    color: var(--color-mute);
    max-width: 44rem;
    line-height: 1.6;
  }

  /* DEMO SHELL */
  .demo-shell {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    max-width: 96rem;
    margin-inline: auto;
    align-items: start;
  }
  @media (min-width: 64rem) {
    .demo-shell { grid-template-columns: minmax(0, 1fr) minmax(0, 1.8fr); column-gap: 4rem; }
  }
  .demo-shell__head {
    font-size: var(--text-2xl);
    line-height: 1.02;
    margin-bottom: 1.5rem;
    max-width: 22rem;
  }
  @media (min-width: 64rem) { .demo-shell__head { font-size: var(--text-3xl); } }
  .demo-shell__body {
    font-size: var(--text-base);
    color: var(--color-ink);
    line-height: 1.65;
    margin-bottom: 1rem;
    max-width: 32rem;
  }
  .demo-shell__body--mute { color: var(--color-mute); font-size: var(--text-sm); margin-top: 0.5rem; }
  .demo-shell__body strong { font-weight: 700; }

  /* BUILDS */
  .builds {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    max-width: 88rem;
    margin-inline: auto;
  }
  @media (min-width: 64rem) {
    .builds { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 3rem; }
  }
  .build {
    border-top: 1px solid var(--color-ink);
    padding-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .build__meta {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-mute);
  }
  .build__label { color: var(--color-ink); }
  .build__title { font-size: var(--text-xl); line-height: 1.05; }
  .build__sub {
    font-size: var(--text-base);
    color: var(--color-mute);
    line-height: 1.55;
    max-width: 38rem;
  }

  /* NEXT */
  .next { max-width: 72rem; margin-inline: auto; }
  .next__head { font-size: var(--text-2xl); margin-bottom: 1.5rem; }
  .next__list {
    list-style: none;
    margin: 0 0 2rem 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-top: 1px solid var(--color-hairline);
    padding-top: 1rem;
  }
  .next__list li {
    display: flex;
    gap: 1rem;
    font-size: var(--text-base);
    padding: 0.25rem 0;
  }
  .next__num {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--color-mute);
    min-width: 2rem;
  }
  .next__foot { font-size: var(--text-sm); color: var(--color-mute); }
  .next__link {
    text-decoration: underline;
    text-underline-offset: 3px;
    color: var(--color-ink);
  }

  /* ISLAND host */
  .demo-shell__island {
    border: 1px solid var(--color-ink);
    background: var(--color-paper);
    padding: 1.5rem;
  }

  /* ============================================================
     OpsTeam island styles — scoped via :global()
     ============================================================ */

  :global(.ot) {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    font-family: var(--font-sans);
  }

  /* form */
  :global(.ot__form) {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  :global(.ot__label) {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-mute);
    margin: 0 0 0.5rem 0;
  }

  /* sector tabs */
  :global(.ot__sectors) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  :global(.ot__sector) {
    background: var(--color-paper);
    border: 1px solid var(--color-hairline);
    color: var(--color-mute);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    padding: 0.4rem 0.85rem;
    cursor: pointer;
    transition: all 120ms ease;
  }
  :global(.ot__sector:hover:not(:disabled)) {
    color: var(--color-ink);
    border-color: var(--color-ink);
  }
  :global(.ot__sector--active) {
    background: var(--color-ink);
    color: var(--color-paper);
    border-color: var(--color-ink);
  }
  :global(.ot__sector:disabled) { opacity: 0.5; cursor: not-allowed; }

  /* example chips */
  :global(.ot__examples) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  :global(.ot__example) {
    background: var(--color-paper-2);
    border: 1px solid var(--color-hairline);
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    padding: 0.4rem 0.85rem;
    cursor: pointer;
    text-align: left;
    transition: all 120ms ease;
  }
  :global(.ot__example:hover:not(:disabled)) {
    background: var(--color-ink);
    color: var(--color-paper);
    border-color: var(--color-ink);
  }
  :global(.ot__example:disabled) { opacity: 0.5; cursor: not-allowed; }

  /* textarea + actions */
  :global(.ot__textarea) {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    line-height: 1.55;
    padding: 0.75rem;
    border: 1px solid var(--color-ink);
    background: var(--color-paper);
    color: var(--color-ink);
    resize: vertical;
    min-height: 7rem;
    width: 100%;
    box-sizing: border-box;
  }
  :global(.ot__textarea:focus-visible) {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }
  :global(.ot__row) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    margin-top: 0.65rem;
  }
  :global(.ot__count) { color: var(--color-mute); }
  :global(.ot__actions) { display: flex; gap: 0.5rem; }
  :global(.ot__btn) {
    background: var(--color-ink);
    color: var(--color-paper);
    padding: 0.6rem 1.2rem;
    font-size: var(--text-sm);
    font-weight: 500;
    border: 0;
    cursor: pointer;
    font-family: var(--font-sans);
  }
  :global(.ot__btn:hover:not(:disabled)) { background: var(--color-mute); }
  :global(.ot__btn:disabled) { opacity: 0.5; cursor: not-allowed; }
  :global(.ot__btn--ghost) {
    background: transparent;
    color: var(--color-ink);
    border: 1px solid var(--color-ink);
  }
  :global(.ot__btn--ghost:hover) {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  :global(.ot__turnstile) { min-height: 0; }
  :global(.ot__error) {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-ink);
    border-top: 1px solid var(--color-hairline);
    padding-top: 1rem;
  }
  :global(.ot__disclaimer) {
    font-size: var(--text-xs);
    color: var(--color-mute);
    line-height: 1.55;
    max-width: 46rem;
    margin: 0;
  }

  /* roles list */
  :global(.ot__roles) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    border-top: 1px solid var(--color-hairline);
    padding-top: 1rem;
  }
  :global(.ot-role) {
    border: 1px solid var(--color-hairline);
    background: var(--color-paper);
    padding: 0.9rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    animation: ot-fade-in 260ms ease-out;
  }
  :global(.ot-role--active) {
    border-color: var(--color-ink);
    box-shadow: inset 3px 0 0 var(--color-ink);
  }
  :global(.ot-role--done) { border-color: var(--color-ink); }
  :global(.ot-role__head) {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  :global(.ot-role__num) { color: var(--color-mute); min-width: 1.5rem; }
  :global(.ot-role__title) { color: var(--color-ink); flex: 1; }
  :global(.ot-role__status) {
    display: inline-flex;
    align-items: center;
    color: var(--color-ink);
  }
  :global(.ot-role__pending) { color: var(--color-mute); font-size: var(--text-xs); }
  :global(.ot-role__body) {
    border-top: 1px dashed var(--color-hairline);
    padding-top: 0.9rem;
  }

  /* shared card primitives */
  :global(.ot-card) {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    font-size: var(--text-sm);
  }
  :global(.ot-card__note) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-mute);
    margin: 0;
    line-height: 1.5;
  }
  :global(.ot-pl-k) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-mute);
  }
  :global(.ot-pl-v) {
    font-size: var(--text-sm);
    color: var(--color-ink);
    line-height: 1.55;
  }

  /* Stage 1 — email card */
  :global(.ot-email) {
    border: 1px solid var(--color-hairline);
    background: var(--color-paper-2);
  }
  :global(.ot-email__head) {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-hairline);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  :global(.ot-email__line) {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  :global(.ot-email__k) {
    color: var(--color-mute);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  :global(.ot-email__v) { color: var(--color-ink); }
  :global(.ot-email__v--strong) { font-family: var(--font-sans); font-weight: 600; font-size: var(--text-sm); }
  :global(.ot-email__body) {
    padding: 1rem;
    line-height: 1.65;
    color: var(--color-ink);
    white-space: pre-wrap;
  }

  /* Stage 2 — ops tasks */
  :global(.ot-tasks) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  :global(.ot-task) {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 0.85rem;
    align-items: start;
  }
  :global(.ot-task__check) {
    width: 16px;
    height: 16px;
    border: 1.5px solid var(--color-ink);
    margin-top: 0.2rem;
  }
  :global(.ot-task__body) {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  :global(.ot-task__title) {
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--color-ink);
    font-weight: 500;
  }
  :global(.ot-task__meta) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  :global(.ot-pill) {
    background: var(--color-paper-2);
    border: 1px solid var(--color-hairline);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: 0.15rem 0.5rem;
    color: var(--color-ink);
  }
  :global(.ot-pill--when) { background: var(--color-ink); color: var(--color-paper); border-color: var(--color-ink); }
  :global(.ot-task__why) {
    font-size: var(--text-xs);
    color: var(--color-mute);
    line-height: 1.5;
  }

  /* Stage 3 — founder quote */
  :global(.ot-quote) {
    margin: 0;
    padding: 1rem 1.25rem;
    background: var(--color-paper-2);
    border-left: 3px solid var(--color-ink);
    font-size: var(--text-base);
    line-height: 1.65;
    font-style: normal;
    color: var(--color-ink);
  }
  :global(.ot-founder-row) {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    align-items: baseline;
  }
  :global(.ot-tag) {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  :global(.ot-tag__label) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-mute);
  }
  :global(.ot-tag__val) {
    background: var(--color-highlight);
    padding: 0.1rem 0.5rem;
    font-size: var(--text-sm);
    color: var(--color-ink);
    font-weight: 500;
  }

  /* Stage 4 — Slack message */
  :global(.ot-slack) {
    border: 1px solid var(--color-hairline);
    background: var(--color-paper-2);
    padding: 0.85rem 1rem;
  }
  :global(.ot-slack__channel) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-mute);
    margin-bottom: 0.5rem;
  }
  :global(.ot-slack__text) {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-ink);
    white-space: pre-wrap;
  }
  :global(.ot-followup) {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    align-items: baseline;
  }

  /* spinner */
  :global(.ot-spinner) {
    animation: ot-spin 800ms linear infinite;
    transform-origin: center;
  }
  @keyframes ot-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  @keyframes ot-fade-in {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.ot-role) { animation: none; }
    :global(.ot-spinner) { animation: none; }
  }
</style>
