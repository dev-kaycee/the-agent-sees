---
export const prerender = true;

import Base from "../components/layout/Base.astro";
import Section from "../components/ui/Section.astro";
import Rule from "../components/ui/Rule.astro";
import Cube from "../components/Cube.astro";
import OpsTeam from "../components/islands/OpsTeam.tsx";

const turnstileSiteKey = "0x4AAAAAADRM5l2r0QMiXnmH";

const trusted = [
  { name: "Northline", style: "serif" },
  { name: "steadfast", style: "italic" },
  { name: "waymark", style: "bold" },
  { name: "LATTICE", style: "tracked" },
  { name: "parcel", style: "thin" },
  { name: "CURRENT", style: "spaced" },
];

const specialists = [
  {
    color: "var(--color-cs)",
    num: "01 — :02s",
    name: "Customer Success",
    desc: "Understands the issue, checks history, drafts a response.",
    chip: "Analyzing",
    icon: "M3 8l9 6 9-6M3 8v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8M3 8l9-5 9 5",
  },
  {
    color: "var(--color-ops)",
    num: "02 — :04s",
    name: "Operations",
    desc: "Verifies policy, routes work, confirms feasibility.",
    chip: "Verifying",
    icon: "M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11",
  },
  {
    color: "var(--color-founder)",
    num: "03 — :06s",
    name: "Founder",
    desc: "Reviews impact, approves the call, sets direction.",
    chip: "Approving",
    icon: "M22 11.08V12a10 10 0 1 1-5.93-9.14M22 4L12 14.01l-3-3",
  },
  {
    color: "var(--color-comms)",
    num: "04 — :09s",
    name: "Communications",
    desc: "Sends the right message, updates the customer, closes the loop.",
    chip: "Resolved",
    icon: "M11 5L6 9H2v6h4l5 4V5zM19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07",
  },
];
---
<Base title="The Agent Sees — AI-powered MVPs and the agents that run inside" metaMiddle="STUDIO · Nº01" metaRight="2026 →">
  <!-- HERO -->
  <section class="hero">
    <div class="hero__inner">
      <div class="hero__copy">
        <p class="hero__eyebrow">WE BUILD WHAT MOVES YOUR BUSINESS</p>
        <h1 class="hero__head">
          AI-powered MVPs.<br />
          <em>Agents</em> that run inside.
        </h1>
        <p class="hero__sub">
          We're a studio, not a vendor. We design and build AI-powered products and the specialist agents that execute the work, end-to-end.
        </p>
        <div class="hero__cta-row">
          <a class="btn btn--primary" href="/contact">
            Book a Strategy Call
            <span aria-hidden="true">→</span>
          </a>
          <a class="btn btn--ghost" href="#demo">
            See How It Works
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <p class="trust__label">Trusted by founders and operators</p>
        <div class="trust__logos">
          {trusted.map((t) => (
            <span class={`trust__logo trust__logo--${t.style}`}>{t.name}</span>
          ))}
        </div>
      </div>

      <div class="hero__cube">
        <Cube />
      </div>
    </div>
  </section>

  <!-- FOUR SPECIALISTS -->
  <section class="specialists">
    <div class="specialists__head">
      <div>
        <p class="hero__eyebrow">FOUR SPECIALISTS · ONE FLOW</p>
        <h2 class="specialists__head-h">
          A real business event.<br />
          Handled in <em>fifteen seconds</em>.
        </h2>
      </div>
      <p class="specialists__sub">
        When something happens in your business, four specialist agents align, decide, and act — together. You get the outcome. They handle the rest.
      </p>
    </div>

    <div class="specialists__grid">
      {specialists.map((s) => (
        <article class="spec magnetic">
          <div class="spec__circle" style={`background: ${s.color};`}>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d={s.icon} />
            </svg>
          </div>
          <p class="spec__num">{s.num}</p>
          <h3 class="spec__name">{s.name}</h3>
          <p class="spec__desc">{s.desc}</p>
          <span class="spec__chip" style={`border-color: ${s.color}; color: ${s.color};`}>
            {s.chip}
          </span>
        </article>
      ))}
    </div>

    <div class="specialists__strip">
      <div class="specialists__strip-left">
        <span class="live-dot" aria-hidden="true"></span>
        <span>Outcome delivered. Customer aligned. Team aligned.</span>
      </div>
      <div class="specialists__strip-right">
        Total time: <strong>15 seconds</strong>
      </div>
    </div>
  </section>

  <Rule weight="hairline" />

  <!-- LIVE DEMO -->
  <Section label="Live demo · Run your ops team" id="demo">
    <div class="demo">
      <div class="demo__copy">
        <h2 class="demo__head">
          One event in.<br />
          A whole team out.
        </h2>
        <p class="demo__body">
          Pick a sector. Pick a scenario — or type your own. Watch four agents act as four roles on your team, all working off a single event in seconds. This is what we wire into your inbox, CRM, and tools.
        </p>
        <p class="demo__body demo__body--mute">
          Free model (Llama 3.3 70B via Cloudflare Workers AI). No signup. Rate-limited to keep it free.
        </p>
      </div>
      <div class="demo__island">
        <OpsTeam client:visible turnstileSiteKey={turnstileSiteKey} />
      </div>
    </div>
  </Section>

  <Rule weight="hairline" />

  <!-- CTA -->
  <section class="closer">
    <div class="closer__inner">
      <h2 class="closer__head">Want a team like this wired into your business?</h2>
      <p class="closer__sub">
        Book a 30-minute strategy call. We'll map the agents that would handle your highest-leverage events and show you what a 4-week build looks like.
      </p>
      <a class="btn btn--primary btn--lg" href="/contact">
        Book a Strategy Call
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Base>

<style>
  /* ============ HERO ============ */
  .hero {
    position: relative;
    padding-inline: var(--spacing-gutter-sm);
    padding-block: 3rem 4rem;
    overflow: hidden;
  }
  @media (min-width: 48rem) {
    .hero { padding-inline: var(--spacing-gutter-md); padding-block: 4rem 5rem; }
  }
  @media (min-width: 64rem) {
    .hero { padding-inline: var(--spacing-gutter-lg); padding-block: 5rem 6rem; }
  }
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    max-width: 86rem;
    margin-inline: auto;
    align-items: center;
  }
  @media (min-width: 64rem) {
    .hero__inner { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 4rem; }
  }

  .hero__eyebrow {
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-mute);
    font-weight: 500;
    margin-bottom: 1.5rem;
  }

  .hero__head {
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    font-weight: 700;
    margin-bottom: 1.5rem;
    max-width: 18ch;
  }
  .hero__head em {
    font-style: normal;
    color: var(--color-mute-strong);
  }

  .hero__sub {
    font-size: 17px;
    line-height: 1.55;
    color: var(--color-mute-strong);
    max-width: 32rem;
    margin-bottom: 2rem;
  }

  .hero__cta-row {
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  /* Trust strip */
  .trust__label {
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-mute);
    margin-bottom: 0.85rem;
  }
  .trust__logos {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem;
    align-items: center;
    color: var(--color-mute-strong);
    opacity: 0.7;
    font-size: 16px;
  }
  .trust__logo--serif   { font-family: Georgia, serif; font-weight: 500; }
  .trust__logo--italic  { font-style: italic; font-weight: 400; }
  .trust__logo--bold    { font-weight: 700; letter-spacing: -0.01em; }
  .trust__logo--tracked { letter-spacing: 0.06em; font-weight: 600; }
  .trust__logo--thin    { font-weight: 300; letter-spacing: -0.01em; }
  .trust__logo--spaced  { letter-spacing: 0.18em; font-weight: 500; }

  /* ============ BUTTONS ============ */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.4rem;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    border-radius: 2px;
    transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease, color 180ms ease;
  }
  .btn--primary {
    background: var(--color-paper);
    color: var(--color-ink);
  }
  .btn--primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 22px rgba(232, 229, 221, 0.16);
  }
  .btn--ghost {
    background: transparent;
    color: var(--color-paper);
    border: 1px solid var(--color-hairline-strong);
  }
  .btn--ghost:hover {
    border-color: var(--color-paper);
  }
  .btn--lg { padding: 1.05rem 1.8rem; font-size: 15px; }

  /* ============ SPECIALISTS ============ */
  .specialists {
    padding-inline: var(--spacing-gutter-sm);
    padding-block: 4rem;
    border-top: 1px solid var(--color-hairline);
    background: var(--color-ink-2);
  }
  @media (min-width: 48rem) {
    .specialists { padding-inline: var(--spacing-gutter-md); }
  }
  @media (min-width: 64rem) {
    .specialists { padding-inline: var(--spacing-gutter-lg); padding-block: 5.5rem; }
  }
  .specialists__head {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 3rem;
    max-width: 86rem;
    margin-inline: auto;
    align-items: end;
  }
  @media (min-width: 64rem) {
    .specialists__head { grid-template-columns: 1fr 1fr; gap: 4rem; }
  }
  .specialists__head-h {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 700;
  }
  .specialists__head-h em {
    font-style: italic;
    color: var(--color-mute-strong);
  }
  .specialists__sub {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-mute-strong);
    max-width: 32rem;
  }

  .specialists__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--color-hairline);
    border: 1px solid var(--color-hairline);
    max-width: 86rem;
    margin-inline: auto;
  }
  @media (min-width: 64rem) {
    .specialists__grid { grid-template-columns: repeat(4, 1fr); }
  }
  .spec {
    padding: 2rem 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
    background: var(--color-ink-2);
  }
  .spec__circle {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-ink);
    margin-bottom: 0.5rem;
  }
  .spec__num {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    color: var(--color-mute);
    font-weight: 500;
  }
  .spec__name {
    font-size: 15px;
    font-weight: 600;
    color: var(--color-paper);
  }
  .spec__desc {
    font-size: 13px;
    color: var(--color-mute-strong);
    line-height: 1.55;
    max-width: 18rem;
  }
  .spec__chip {
    margin-top: 0.6rem;
    font-size: 10px;
    padding: 0.22rem 0.65rem;
    border: 1px solid;
    border-radius: 999px;
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
  }

  .specialists__strip {
    margin-top: 2.5rem;
    padding: 1rem 1.4rem;
    border: 1px solid var(--color-hairline);
    background: rgba(232, 229, 221, 0.02);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 13px;
    max-width: 86rem;
    margin-inline: auto;
    border-radius: 2px;
  }
  .specialists__strip-left {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }
  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-ops);
    animation: live-pulse 2.4s ease-in-out infinite;
  }
  @keyframes live-pulse {
    0%, 100% { opacity: 0.4; transform: scale(0.85); }
    50% { opacity: 1; transform: scale(1); }
  }
  .specialists__strip-right { color: var(--color-mute-strong); }
  .specialists__strip-right strong { color: var(--color-paper); font-weight: 600; }

  /* ============ DEMO ============ */
  .demo {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    max-width: 92rem;
    margin-inline: auto;
    align-items: start;
  }
  @media (min-width: 64rem) {
    .demo { grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr); column-gap: 4rem; }
  }
  .demo__head {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    line-height: 1.05;
    margin-bottom: 1.25rem;
    max-width: 22rem;
  }
  .demo__body {
    font-size: 15px;
    color: var(--color-mute-strong);
    line-height: 1.6;
    margin-bottom: 1rem;
    max-width: 32rem;
  }
  .demo__body--mute { color: var(--color-mute); font-size: 13px; }
  .demo__island {
    border: 1px solid var(--color-hairline-strong);
    background: var(--color-ink-2);
    padding: 1.5rem;
    border-radius: 2px;
  }

  /* ============ CLOSER ============ */
  .closer {
    padding-inline: var(--spacing-gutter-sm);
    padding-block: 4rem 5rem;
    background: var(--color-ink-2);
    border-top: 1px solid var(--color-hairline);
  }
  @media (min-width: 48rem) {
    .closer { padding-inline: var(--spacing-gutter-md); }
  }
  @media (min-width: 64rem) {
    .closer { padding-inline: var(--spacing-gutter-lg); padding-block: 5rem 6rem; }
  }
  .closer__inner {
    max-width: 60rem;
    margin-inline: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
  }
  .closer__head {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.1;
    font-weight: 700;
    max-width: 22ch;
  }
  .closer__sub {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-mute-strong);
    max-width: 40rem;
  }

  /* ============ ISLAND COLORS (dark) ============ */
  :global(.ot) {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    font-family: var(--font-sans);
    color: var(--color-paper);
  }
  :global(.ot__form) {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  :global(.ot__label) {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-mute);
    margin: 0 0 0.5rem 0;
  }
  :global(.ot__sectors), :global(.ot__examples) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  :global(.ot__sector) {
    background: var(--color-ink-3);
    border: 1px solid var(--color-hairline);
    color: var(--color-mute-strong);
    font-family: var(--font-sans);
    font-size: 13px;
    padding: 0.4rem 0.9rem;
    cursor: pointer;
    border-radius: 2px;
    transition: all 160ms;
  }
  :global(.ot__sector:hover:not(:disabled)) {
    color: var(--color-paper);
    border-color: var(--color-hairline-strong);
  }
  :global(.ot__sector--active) {
    background: var(--color-paper);
    color: var(--color-ink);
    border-color: var(--color-paper);
  }
  :global(.ot__sector:disabled) { opacity: 0.45; cursor: not-allowed; }

  :global(.ot__example) {
    background: var(--color-ink-3);
    border: 1px solid var(--color-hairline);
    color: var(--color-paper);
    font-family: var(--font-sans);
    font-size: 13px;
    padding: 0.42rem 0.9rem;
    cursor: pointer;
    text-align: left;
    border-radius: 2px;
    transition: all 160ms;
  }
  :global(.ot__example:hover:not(:disabled)) {
    background: var(--color-founder);
    color: var(--color-ink);
    border-color: var(--color-founder);
  }
  :global(.ot__example:disabled) { opacity: 0.45; cursor: not-allowed; }

  :global(.ot__textarea) {
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.55;
    padding: 0.85rem;
    border: 1px solid var(--color-hairline-strong);
    background: var(--color-ink-3);
    color: var(--color-paper);
    resize: vertical;
    min-height: 7rem;
    width: 100%;
    border-radius: 2px;
  }
  :global(.ot__textarea:focus-visible) {
    outline: 1px solid var(--color-founder);
    outline-offset: 2px;
    border-color: var(--color-founder);
  }
  :global(.ot__row) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 11px;
    margin-top: 0.65rem;
    color: var(--color-mute);
  }
  :global(.ot__count) { color: var(--color-mute); }
  :global(.ot__actions) { display: flex; gap: 0.5rem; }
  :global(.ot__btn) {
    background: var(--color-paper);
    color: var(--color-ink);
    padding: 0.65rem 1.25rem;
    font-size: 13px;
    font-weight: 600;
    border: 0;
    cursor: pointer;
    font-family: var(--font-sans);
    border-radius: 2px;
    transition: transform 160ms, box-shadow 160ms;
  }
  :global(.ot__btn:hover:not(:disabled)) {
    transform: translateY(-1px);
    box-shadow: 0 4px 18px rgba(232, 229, 221, 0.16);
  }
  :global(.ot__btn:disabled) { opacity: 0.5; cursor: not-allowed; transform: none; box-shadow: none; }
  :global(.ot__btn--ghost) {
    background: transparent;
    color: var(--color-paper);
    border: 1px solid var(--color-hairline-strong);
  }
  :global(.ot__btn--ghost:hover) { border-color: var(--color-paper); background: transparent; }
  :global(.ot__turnstile) { min-height: 0; }
  :global(.ot__error) {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--color-comms);
    border-top: 1px solid var(--color-hairline);
    padding-top: 1rem;
  }
  :global(.ot__disclaimer) {
    font-size: 11px;
    color: var(--color-mute);
    line-height: 1.6;
    max-width: 46rem;
    margin: 0;
  }

  /* roles list */
  :global(.ot__roles) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    border-top: 1px solid var(--color-hairline);
    padding-top: 1rem;
  }
  :global(.ot-role) {
    border: 1px solid var(--color-hairline);
    background: var(--color-ink-3);
    padding: 1rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    border-radius: 2px;
    animation: ot-fade-in 280ms ease-out;
  }
  :global(.ot-role--active) {
    border-color: var(--color-founder);
    box-shadow: inset 3px 0 0 var(--color-founder);
  }
  :global(.ot-role--done) {
    border-color: var(--color-hairline-strong);
  }
  :global(.ot-role:nth-child(1).ot-role--done) { border-left: 3px solid var(--color-cs); }
  :global(.ot-role:nth-child(2).ot-role--done) { border-left: 3px solid var(--color-ops); }
  :global(.ot-role:nth-child(3).ot-role--done) { border-left: 3px solid var(--color-founder); }
  :global(.ot-role:nth-child(4).ot-role--done) { border-left: 3px solid var(--color-comms); }

  :global(.ot-role__head) {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  :global(.ot-role__num) { color: var(--color-mute); min-width: 1.5rem; }
  :global(.ot-role__title) { color: var(--color-paper); flex: 1; }
  :global(.ot-role__status) {
    display: inline-flex;
    align-items: center;
    color: var(--color-founder);
  }
  :global(.ot-role__pending) { color: var(--color-mute); font-size: 11px; }
  :global(.ot-role__body) {
    border-top: 1px dashed var(--color-hairline);
    padding-top: 0.95rem;
  }

  /* shared card primitives */
  :global(.ot-card) {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    font-size: 13px;
    color: var(--color-paper);
  }
  :global(.ot-card__note) {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-mute);
    margin: 0;
    line-height: 1.5;
  }
  :global(.ot-pl-k) {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-mute);
  }
  :global(.ot-pl-v) {
    font-size: 13px;
    color: var(--color-paper);
    line-height: 1.55;
  }

  /* Stage 1 — email card */
  :global(.ot-email) {
    border: 1px solid var(--color-hairline-strong);
    background: var(--color-ink-2);
    border-radius: 2px;
  }
