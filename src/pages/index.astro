---
export const prerender = true;

import Base from "../components/layout/Base.astro";
import Cube from "../components/Cube.astro";
import Rule from "../components/ui/Rule.astro";

const trusted = [
  { name: "Northline", style: "serif" },
  { name: "steadfast", style: "italic" },
  { name: "waymark", style: "bold" },
  { name: "LATTICE", style: "tracked" },
  { name: "parcel", style: "thin" },
  { name: "CURRENT", style: "spaced" },
];

const specialists = [
  {
    color: "var(--color-cs)",
    num: "01 — :02s",
    name: "Customer Success",
    desc: "Understands the issue, checks history, drafts a response.",
    chip: "Analyzing",
    icon: "M3 8l9 6 9-6M3 8v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8M3 8l9-5 9 5",
  },
  {
    color: "var(--color-ops)",
    num: "02 — :04s",
    name: "Operations",
    desc: "Verifies policy, routes work, confirms feasibility.",
    chip: "Verifying",
    icon: "M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11",
  },
  {
    color: "var(--color-founder)",
    num: "03 — :06s",
    name: "Founder",
    desc: "Reviews impact, approves the call, sets direction.",
    chip: "Approving",
    icon: "M22 11.08V12a10 10 0 1 1-5.93-9.14M22 4L12 14.01l-3-3",
  },
  {
    color: "var(--color-comms)",
    num: "04 — :09s",
    name: "Communications",
    desc: "Sends the right message, updates the customer, closes the loop.",
    chip: "Resolved",
    icon: "M11 5L6 9H2v6h4l5 4V5zM19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07",
  },
];

const approach = [
  {
    title: "Strategic by design",
    body: "We start with outcomes, not features. Every decision is tied to business impact.",
    icon: "M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z M9 22V12h6v10",
  },
  {
    title: "Built for speed",
    body: "MVPs in weeks, not months. Lean builds, rapid iteration, real-world feedback.",
    icon: "M13 2L3 14h9l-1 8 10-12h-9l1-8z",
  },
  {
    title: "Agents that work",
    body: "Specialist AI agents that execute real work across your business.",
    icon: "M12 2a3 3 0 0 0-3 3v0a3 3 0 0 0 3 3M12 8v6M9 11h6 M5 21l3-8 4 2 4-2 3 8",
  },
  {
    title: "Yours, not ours",
    body: "You own everything. We build it with you, then step back.",
    icon: "M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z",
  },
];
---
<Base
  title="The Agent Sees — AI-powered MVPs and the agents that run inside"
  description="A studio, not a vendor. We design and build AI-powered products and the specialist agents that execute the work, end-to-end."
  metaMiddle="STUDIO · Nº01"
  metaRight="2026 →"
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero__inner">
      <div class="hero__copy">
        <p class="hero__eyebrow">WE BUILD WHAT MOVES YOUR BUSINESS</p>
        <h1 class="hero__head">
          AI-powered MVPs.<br />
          <em>Agents</em> that run inside.
        </h1>
        <p class="hero__sub">
          We're a studio, not a vendor. We design and build AI-powered products and the specialist agents that execute the work, end-to-end.
        </p>
        <div class="hero__cta-row">
          <a class="btn btn--primary" href="/contact">
            Book a Strategy Call
            <span aria-hidden="true">→</span>
          </a>
          <a class="btn btn--ghost" href="/work#demo">
            See How It Works
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <p class="trust__label">Trusted by founders and operators</p>
        <div class="trust__logos">
          {trusted.map((t) => (
            <span class={`trust__logo trust__logo--${t.style}`}>{t.name}</span>
          ))}
        </div>
      </div>

      <div class="hero__cube">
        <Cube />
      </div>
    </div>
  </section>

  <!-- FOUR SPECIALISTS -->
  <section class="specialists">
    <div class="specialists__head">
      <div>
        <p class="hero__eyebrow">FOUR SPECIALISTS · ONE FLOW</p>
        <h2 class="specialists__head-h">
          A real business event.<br />
          Handled in <em>fifteen seconds</em>.
        </h2>
      </div>
      <p class="specialists__sub">
        When something happens in your business, four specialist agents align, decide, and act — together. You get the outcome. They handle the rest.
      </p>
    </div>

    <div class="specialists__grid">
      {specialists.map((s) => (
        <article class="spec">
          <div class="spec__circle" style={`background: ${s.color};`}>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d={s.icon} />
            </svg>
          </div>
          <p class="spec__num">{s.num}</p>
          <h3 class="spec__name">{s.name}</h3>
          <p class="spec__desc">{s.desc}</p>
          <span class="spec__chip" style={`border-color: ${s.color}; color: ${s.color};`}>
            {s.chip}
          </span>
        </article>
      ))}
    </div>

    <div class="specialists__strip">
      <div class="specialists__strip-left">
        <span class="live-dot" aria-hidden="true"></span>
        <span>Outcome delivered. Customer aligned. Team aligned.</span>
      </div>
      <div class="specialists__strip-right">
        Total time: <strong>15 seconds</strong>
      </div>
    </div>
  </section>

  <!-- APPROACH -->
  <section class="approach">
    <div class="approach__head">
      <p class="hero__eyebrow">OUR STUDIO APPROACH</p>
      <h2 class="approach__h">
        We don't hand you tools.<br />
        We build <em>outcomes</em>.
      </h2>
      <p class="approach__sub">
        We partner with ambitious teams to go from idea to AI-powered MVP — fast. Then we embed the agents and systems that keep it running.
      </p>
      <a class="btn btn--primary" href="/work#demo">
        Explore Our Approach
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="approach__grid">
      {approach.map((a) => (
        <article class="appr">
          <div class="appr__icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d={a.icon} />
            </svg>
          </div>
          <h3 class="appr__title">{a.title}</h3>
          <p class="appr__body">{a.body}</p>
        </article>
      ))}
    </div>
  </section>

  <Rule weight="hairline" />

  <!-- FROM IDEA TO IMPACT -->
  <section class="impact">
    <div class="impact__copy">
      <p class="hero__eyebrow">FROM IDEA TO IMPACT</p>
      <h2 class="impact__h">
        We don't work with founders,<br />
        operators, and teams who<br />
        move fast and think long-term.
      </h2>
      <a class="btn btn--ghost" href="/work">
        See Our Work
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="impact__stats">
      <article class="impact__stat">
        <div class="impact__stat-num">Live</div>
        <div class="impact__stat-label">Demo running</div>
      </article>
      <article class="impact__stat">
        <div class="impact__stat-num">4–8 wks</div>
        <div class="impact__stat-label">Average time to launch</div>
      </article>
      <article class="impact__stat">
        <div class="impact__stat-num">Open</div>
        <div class="impact__stat-label">Booking discovery calls</div>
      </article>
    </div>
  </section>
</Base>

<style>
  /* ============ HERO ============ */
  .hero {
    position: relative;
    padding-inline: var(--spacing-gutter-sm);
    padding-block: 3rem 4rem;
    overflow: hidden;
  }
  @media (min-width: 48rem) {
    .hero { padding-inline: var(--spacing-gutter-md); padding-block: 4rem 5rem; }
  }
  @media (min-width: 64rem) {
    .hero { padding-inline: var(--spacing-gutter-lg); padding-block: 5rem 6rem; }
  }
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    max-width: 86rem;
    margin-inline: auto;
    align-items: center;
  }
  @media (min-width: 64rem) {
    .hero__inner { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 4rem; }
  }

  .hero__eyebrow {
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-mute);
    font-weight: 500;
    margin-bottom: 1.5rem;
  }

  .hero__head {
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    font-weight: 700;
    margin-bottom: 1.5rem;
    max-width: 18ch;
  }
  .hero__head em {
    font-style: normal;
    color: var(--color-mute-strong);
  }

  .hero__sub {
    font-size: 17px;
    line-height: 1.55;
    color: var(--color-mute-strong);
    max-width: 32rem;
    margin-bottom: 2rem;
  }

  .hero__cta-row {
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  /* Trust strip */
  .trust__label {
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-mute);
    margin-bottom: 0.85rem;
  }
  .trust__logos {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem;
    align-items: center;
    color: var(--color-mute-strong);
    opacity: 0.7;
    font-size: 16px;
  }
  .trust__logo--serif   { font-family: Georgia, serif; font-weight: 500; }
  .trust__logo--italic  { font-style: italic; font-weight: 400; }
  .trust__logo--bold    { font-weight: 700; letter-spacing: -0.01em; }
  .trust__logo--tracked { letter-spacing: 0.06em; font-weight: 600; }
  .trust__logo--thin    { font-weight: 300; letter-spacing: -0.01em; }
  .trust__logo--spaced  { letter-spacing: 0.18em; font-weight: 500; }

  /* ============ BUTTONS ============ */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.4rem;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    border-radius: 2px;
    transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease, color 180ms ease;
  }
  .btn--primary {
    background: var(--color-paper);
    color: var(--color-ink);
  }
  .btn--primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 22px rgba(232, 229, 221, 0.16);
  }
  .btn--ghost {
    background: transparent;
    color: var(--color-paper);
    border: 1px solid var(--color-hairline-strong);
  }
  .btn--ghost:hover {
    border-color: var(--color-paper);
  }

  /* ============ SPECIALISTS ============ */
  .specialists {
    padding-inline: var(--spacing-gutter-sm);
    padding-block: 4rem;
    border-top: 1px solid var(--color-hairline);
    background: var(--color-ink-2);
  }
  @media (min-width: 48rem) {
    .specialists { padding-inline: var(--spacing-gutter-md); }
  }
  @media (min-width: 64rem) {
    .specialists { padding-inline: var(--spacing-gutter-lg); padding-block: 5.5rem; }
  }
  .specialists__head {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 3rem;
    max-width: 86rem;
    margin-inline: auto;
    align-items: end;
  }
  @media (min-width: 64rem) {
    .specialists__head { grid-template-columns: 1fr 1fr; gap: 4rem; }
  }
  .specialists__head-h {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 700;
  }
  .specialists__head-h em {
    font-style: italic;
    color: var(--color-mute-strong);
  }
  .specialists__sub {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-mute-strong);
    max-width: 32rem;
  }

  .specialists__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--color-hairline);
    border: 1px solid var(--color-hairline);
    max-width: 86rem;
    margin-inline: auto;
  }
  @media (min-width: 64rem) {
    .specialists__grid { grid-template-columns: repeat(4, 1fr); }
  }
  .spec {
    padding: 2rem 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
    background: var(--color-ink-2);
  }
  .spec__circle {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-ink);
    margin-bottom: 0.5rem;
  }
  .spec__num {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    color: var(--color-mute);
    font-weight: 500;
  }
  .spec__name {
    font-size: 15px;
    font-weight: 600;
    color: var(--color-paper);
  }
  .spec__desc {
    font-size: 13px;
    color: var(--color-mute-strong);
    line-height: 1.55;
    max-width: 18rem;
  }
  .spec__chip {
    margin-top: 0.6rem;
    font-size: 10px;
    padding: 0.22rem 0.65rem;
    border: 1px solid;
    border-radius: 999px;
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
  }

  .specialists__strip {
    margin-top: 2.5rem;
    padding: 1rem 1.4rem;
    border: 1px solid var(--color-hairline);
    background: rgba(232, 229, 221, 0.02);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 13px;
    max-width: 86rem;
    margin-inline: auto;
    border-radius: 2px;
  }
  .specialists__strip-left {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--color-paper);
  }
  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-ops);
    animation: live-pulse 2.4s ease-in-out infinite;
  }
  @keyframes live-pulse {
    0%, 100% { opacity: 0.4; transform: scale(0.85); }
    50% { opacity: 1; transform: scale(1); }
  }
  .specialists__strip-right { color: var(--color-mute-strong); }
  .specialists__strip-right strong { color: var(--color-paper); font-weight: 600; }

  /* ============ APPROACH ============ */
  .approach {
    padding-inline: var(--spacing-gutter-sm);
    padding-block: 4rem;
    background: var(--color-ink);
    border-top: 1px solid var(--color-hairline);
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    max-width: 86rem;
    margin-inline: auto;
  }
  @media (min-width: 48rem) {
    .approach { padding-inline: var(--spacing-gutter-md); }
  }
  @media (min-width: 64rem) {
    .approach { padding-inline: var(--spacing-gutter-lg); padding-block: 5.5rem; grid-template-columns: 1fr 1.3fr; gap: 4rem; align-items: start; }
  }
  .approach__h {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 700;
    margin: 0 0 1.25rem;
  }
  .approach__h em {
    font-style: italic;
    color: var(--color-mute-strong);
  }
  .approach__sub {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-mute-strong);
    max-width: 28rem;
    margin-bottom: 2rem;
  }
  .approach__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 48rem) {
    .approach__grid { grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  }
  .appr {
    padding: 1.5rem;
    background: var(--color-ink-2);
    border: 1px solid var(--color-hairline);
    border-radius: 2px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .appr__icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-ink-3);
    border: 1px solid var(--color-hairline-strong);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-paper);
    margin-bottom: 0.5rem;
  }
  .appr__title { font-size: 16px; font-weight: 600; }
  .appr__body { font-size: 13px; color: var(--color-mute-strong); line-height: 1.55; }

  /* ============ IMPACT ============ */
  .impact {
    padding-inline: var(--spacing-gutter-sm);
    padding-block: 4rem;
    background: var(--color-ink-2);
    border-top: 1px solid var(--color-hairline);
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    max-width: 86rem;
    margin-inline: auto;
    align-items: center;
  }
  @media (min-width: 48rem) {
    .impact { padding-inline: var(--spacing-gutter-md); }
  }
  @media (min-width: 64rem) {
    .impact { padding-inline: var(--spacing-gutter-lg); padding-block: 5.5rem; grid-template-columns: 1.2fr 1fr; gap: 4rem; }
  }
  .impact__h {
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    line-height: 1.2;
    font-weight: 700;
    margin: 0 0 1.5rem;
    letter-spacing: -0.02em;
  }
  .impact__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .impact__stat {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .impact__stat-num {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.5vw, 2.4rem);
    font-weight: 700;
    color: var(--color-paper);
    letter-spacing: -0.02em;
  }
  .impact__stat-label {
    font-size: 11px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-mute);
  }
</style>
